    "test": "vitest run",
    "test:e2e": "playwright test",
    "bloqueo": "node scripts/lista-de-bloqueo.mjs",
    "datos": "node scripts/recortar-competencias.mjs",
    "postinstall": "node scripts/recortar-competencias.mjs",
    "prebuild": "node scripts/recortar-competencias.mjs",
    "prestart": "node scripts/recortar-competencias.mjs",
    "validar": "node scripts/validar-competencias.mjs && node scripts/validar-guias.mjs",
    "bloqueo:build": "node scripts/lista-de-bloqueo.mjs --build build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "gray-matter": "^4.0.3",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
